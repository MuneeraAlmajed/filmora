<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="/stylesheets/style.css" />
    <link rel="stylesheet" href="/stylesheets/partials.css" />

    <title>FilmOra</title>
  </head>

  <body>

    <%- include('./partials/_navbar.ejs') %>

    <main class="home">

      <% if(user){ %>

        <h1>Welcome back to FilmOra, <%= user.username %>! 🎬</h1>

        <p>
          Keep track of your movies and discover your next favorite film.
        </p> 
        <div class="movie-stats">

  <div class="stat-card">
    <h3>Watched</h3>
    <p><%= watchedMovies %></p>
  </div>

  <div class="stat-card">
    <h3>All Movies</h3>
    <p><%= totalMovies %></p>
  </div>

  <div class="stat-card">
    <h3>To Watch</h3>
    <p><%= toWatchMovies %></p>
  </div>

  <div class="stat-card">
    <h3>Average Rating</h3>
    <p>⭐ <%= averageRating %></p>
  </div>

</div>

        <a href="/movies/new" class="get-started">
          + Add New Movie
        </a>

        <div class="movie-container">
          <% movies.forEach(movie =>{ %>
            <div class="movie-card">

              <h3><%=movie.title%></h3>
              
              <p>Status: <%=movie.status%></p>
              
              <p>Rating: ⭐ <%= movie.rating || 0 %>/5</p>
              
              <p><%=movie.notes%></p>

               <a href="/movies/<%= movie._id %>">
              View
            </a>

            <a href="/movies/<%= movie._id %>/edit">
              Edit
            </a>

            <form
              action="/movies/<%= movie._id %>?_method=DELETE"
              method="POST"
            >
              <button type="submit">Delete</button>
            </form>

            </div>

          <%})%>

        </div>

        </main>
       

      <% } else { %>

        <main class="home">

        <h1>Welcome to FilmOra! 🎬</h1>

        <p>
          Your personal movie watchlist.
          Organize your favorites, track what you've watched,
          and never forget what you want to see next.
        </p>

        <a href="/auth/sign-up" class="get-started">
          Get Started
        </a>

        </main>

      <% } %>

   

    <%- include('./partials/_footer.ejs') %>

  </body>
</html>