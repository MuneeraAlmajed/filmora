<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/partials.css" />
    <title>
        <%= movie.title %>
    </title>
</head>

<body>

    <main class="movie-show">

    <h1>
        <%= movie.title %>
    </h1>

    <img src="<%= movie.image %>" alt="<%= movie.title %>" class="movie-poster">

    <div class="movie-info">
    <p>Notes: <%= movie.notes %></p>

    <p>Status: <%= movie.status %></p>

    <p class="rating">
    <strong>Rating:</strong>

    <% for (let i = 1; i <= 5; i++) { %>
        <% if (i <= movie.rating) { %>
            <span class="star filled">★</span>
        <% } else { %>
            <span class="star">☆</span>
        <% } %>
    <% } %>
</p>

    </div>

    <div class="movie-actions">

    <a href="/movies/<%= movie._id %>/edit">Edit</a>
    <br><br>

    <form action="/movies/<%= movie._id %>?_method=DELETE" method="POST">
        <button type="submit"  class="del-btn">Delete Movie</button>
    </form>
    <br>

    <a href="/">Back to Home</a>

    <a href="/movies">Go to My  Movies</a>

    </div>

    </main>

</body>

</html>