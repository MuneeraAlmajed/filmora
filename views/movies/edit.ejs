<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/partials.css">
    <title>Edit Movie</title>
</head>

<body>

    <main class="edit-page">

        <h1>Edit <%= movie.title %></h1>

        <nav>
            <a href="/" class="back-home-btn">Back to Home</a>

            <div class="nav-links">
                <a href="/movies">Movies</a>
                <a href="/movies/new">Add Movie</a>
            </div>
        </nav>

        <form action="/movies/<%= movie._id %>?_method=PUT" method="POST" class="movie-form">

            <label for="title">Title:</label>
            <input
                type="text"
                id="title"
                name="title"
                value="<%= movie.title %>"
                required
            >

            <label for="image">Movie Poster:</label>
            <input
                type="text"
                name="image"
                id="image"
                value="<%= movie.image %>"
                placeholder="Paste image URL"
            >

            <label for="notes">Notes:</label>
            <textarea
                id="notes"
                name="notes"
            ><%= movie.notes %></textarea>

            <label for="status">Status:</label>
            <select id="status" name="status">
                <option value="Not yet" <%= movie.status === 'Not yet' ? 'selected' : '' %>>Not yet</option>
                <option value="To watch" <%= movie.status === 'To watch' ? 'selected' : '' %>>To watch</option>
                <option value="Watching" <%= movie.status === 'Watching' ? 'selected' : '' %>>Watching</option>
                <option value="Watched" <%= movie.status === 'Watched' ? 'selected' : '' %>>Watched</option>
            </select>

            <label for="rating">Rating:</label>
            <input
                type="number"
                id="rating"
                name="rating"
                value="<%= movie.rating %>"
                min="0"
                max="5"
                step="1"
            >

            <button type="submit" class="back-home-btn">Update Movie</button>

        </form>

    </main>

</body>
</html>